# Copy to .env — Vite exposes only variables prefixed with VITE_
VITE_API_URL=http://localhost:5000/api

# Sign in with Google: the OAuth "Web application" Client ID from Google Cloud.
# Public, not a secret (it is in every page). Must match the server's GOOGLE_CLIENT_ID.
# Leave empty and the Google button simply does not appear.
VITE_GOOGLE_CLIENT_ID=
