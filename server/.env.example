# Copy this file to .env and fill in real values. NEVER commit .env
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mern_starter
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Voice-over generation (run locally only: npm run voice)
SARVAM_API_KEY=
VOICE_SPEAKER=kavitha
VOICE_PACE=0.92

# Sign in with Google: the same Client ID as the client's VITE_GOOGLE_CLIENT_ID.
# The server checks every Google token was issued FOR this id (the aud claim).
GOOGLE_CLIENT_ID=
